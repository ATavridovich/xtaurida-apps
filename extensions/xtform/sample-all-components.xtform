[% TextInput uuid="f-001" label="Full Name" description="Enter your full legal name" placeholder="Enter your name" /%]

[% TextArea uuid="f-002" label="Bio" description="Tell us about yourself" placeholder="Write a short bio..." /%]

[% IntegerInput uuid="f-003" label="Age" description="Your age in years" min_value="0" max_value="150" /%]

[% DecimalInput uuid="f-004" label="Price" description="Product price in USD" min_value="0" step="0.01" placeholder="0.00" /%]

[% Checkbox uuid="f-005" label="Subscribe to newsletter" description="Receive weekly updates" /%]

[% RadioGroup uuid="f-006" label="Preferred Contact Method" description="How should we contact you?" options="Email,Phone,Text,Option2" /%]

[% MultipleChoice uuid="f-007" label="Communication Channels" description="Select all that apply" options="Email,SMS,Phone,Push Notifications" /%]

[% DatePicker uuid="f-008" label="Birth Date" description="Your date of birth" /%]

[% TimePicker uuid="f-009" label="Preferred Time" description="Best time to contact you" /%]

[% Select uuid="f-010" label="Email" description="Your email address" options="john@example.com,jane@example.com,admin@example.com" /%]