[% Section uuid="s-001" label="Personal Information" %]
  [% TextInput uuid="f-001" label="Full Name" placeholder="Enter your name" /%]
  [% TextInput uuid="f-002" label="Email" placeholder="Enter your email" /%]
  [% IntegerInput uuid="f-003" label="Age" min_value="0" max_value="150" /%]
[% /Section %]

[% CollapsibleSection uuid="s-002" label="Address Details" %]
  [% TextInput uuid="f-004" label="City" placeholder="Enter your city" /%]
[% /CollapsibleSection %]

[% Tab uuid="t-001" label="Professional" %]
  [% TextInput uuid="f-005" label="Job Title" placeholder="Your current role" /%]
[% /Tab %]

[% Tab uuid="t-002" label="Personal" %]
  [% TextArea uuid="f-006" label="Hobbies" placeholder="What do you enjoy doing?" /%]
[% /Tab %]

[% Tab uuid="t-003" label="Preferences" %]
  [% Checkbox uuid="f-007" label="Email notifications" /%]
  [% Select uuid="f-008" label="Newsletter Frequency" options="Daily,Weekly,Monthly" /%]
[% /Tab %]
