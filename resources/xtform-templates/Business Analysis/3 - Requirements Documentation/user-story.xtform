        uuid: "us-003"
        label: "So that..."
  - type: Section
    uuid: "us-009"
    label: "Acceptance Criteria"
    items:
      - type: Table
        uuid: "us-008"
        label: "Acceptance Criteria"
        items:
          - type: TextInput
            uuid: "us-005"
            label: "Given"
          - type: TextInput
            uuid: "us-006"
            label: "When"
          - type: TextInput
            uuid: "us-007"
            label: "Then"
        data: []
