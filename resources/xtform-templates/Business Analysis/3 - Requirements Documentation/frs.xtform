    uuid: "frs-005"
    label: "Functional Requirements"
    items:
      - type: TextInput
        uuid: "frs-001"
        label: "Req ID"
      - type: TextArea
        uuid: "frs-002"
        label: "Description"
      - type: Select
        uuid: "frs-003"
        label: "Priority"
        options: "Must,Should,Could,Won't"
      - type: TextInput
        uuid: "frs-004"
        label: "Source"
    data: []
