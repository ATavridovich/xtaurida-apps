type: Form
uuid: "fsp-form-011"
title: "Feature Specification"
description: "Detailed specification of a single feature, including user flow and edge cases."
elaborate_options:
  - "Product Requirements Document (PRD)"
  - "Acceptance Criteria Specification"
  - "Design Requirements Brief"
items:
  - type: Section
    uuid: "fsp-002"
    label: "Overview"
    items:
      - type: TextArea
        uuid: "fsp-001"
        label: "Overview"
  - type: Section
    uuid: "fsp-004"
    label: "User Flow"
    items:
      - type: TextArea
        uuid: "fsp-003"
        label: "User Flow"
  - type: Section
    uuid: "fsp-008"
    label: "Requirements"
    items:
      - type: Table
        uuid: "fsp-007"
        label: "Requirements"
        items:
          - type: TextInput
            uuid: "fsp-005"
            label: "Requirement"
          - type: Select
            uuid: "fsp-006"
            label: "Priority"
            options: "Must,Should,Could,Won't"
        data: []
  - type: Section
    uuid: "fsp-010"
    label: "Edge Cases"
    items:
      - type: TextArea
        uuid: "fsp-009"
        label: "Edge Cases"
