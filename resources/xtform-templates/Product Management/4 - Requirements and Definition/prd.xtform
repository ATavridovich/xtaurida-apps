type: Form
uuid: "prd-form-016"
title: "Product Requirements Document (PRD)"
description: "Consolidated definition of a product or feature: problem, goals, requirements, non-goals, and success metrics."
elaborate_options:
  - "Feature Specification"
  - "Acceptance Criteria Specification"
  - "Design Requirements Brief"
items:
  - type: Tab
    uuid: "prd-002"
    label: "Overview"
    items:
      - type: TextArea
        uuid: "prd-001"
        label: "Overview"
  - type: Tab
    uuid: "prd-004"
    label: "Problem"
    items:
      - type: TextArea
        uuid: "prd-003"
        label: "Problem Statement"
  - type: Tab
    uuid: "prd-006"
    label: "Goals"
    items:
      - type: TextArea
        uuid: "prd-005"
        label: "Goals"
  - type: Tab
    uuid: "prd-011"
    label: "Requirements"
    items:
      - type: Table
        uuid: "prd-010"
        label: "Requirements"
        items:
          - type: TextInput
            uuid: "prd-007"
            label: "Req ID"
          - type: TextArea
            uuid: "prd-008"
            label: "Description"
          - type: Select
            uuid: "prd-009"
            label: "Priority"
            options: "Must,Should,Could,Won't"
        data: []
  - type: Tab
    uuid: "prd-013"
    label: "Non-Goals"
    items:
      - type: TextArea
        uuid: "prd-012"
        label: "Non-Goals"
  - type: Tab
    uuid: "prd-015"
    label: "Success Metrics"
    items:
      - type: TextArea
        uuid: "prd-014"
        label: "Success Metrics"
